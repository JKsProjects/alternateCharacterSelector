{
	"manifest_version": 3,
	"name": "Alternate Character Selector",
	"version": "0.1",
	
	"description": "Popup allows selection of different-fonted unicode characters.",
	"permissions": ["clipboardWrite"],
	"browser_specific_settings": {
		"gecko": {
			"id": "name@example.com",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},

	"icons":{
		"48": "icons/icon48.png"
	},
	
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["contentScript.js"]
		}
	],

	"action": {
		"default_icon": "icons/icon48.png",
		"default_title": "Alternate Character Selector",
		"default_popup": "main.html"
	}
}
